generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  password           String?
  role               String              @default("MER_USER") // primary role (login/session) — drives permissions
  title              String? // display-only position label (e.g. "DPM Merchandise"); overrides the role label in the UI, permissions still follow `role`
  roles              String[]            @default([]) // all roles this person holds (incl. primary) — 1 person, many positions
  claimDepartment    String?
  isActive           Boolean             @default(true)
  pullRm             Boolean             @default(false) // part of the Pull Material flow → gets stage alerts
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  priority           Int?
  bu                 String              @default("NYG")
  procurementType    String?
  resetToken         String?             @unique
  resetTokenExpiry   DateTime?
  loginToken         String?             @unique
  loginTokenExpiry   DateTime?
  signatureData      String? // master signature (base64 PNG data URI) reused on approvals
  signatureUpdatedAt DateTime?
  airRequests        AirRequest[]
  approvals          ApprovalLog[]
  claimApprovals     ClaimApproval[]
  attachments        RequestAttachment[]
}

model MasterBrand {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
}

model MasterBU {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
}

model MasterDescription {
  id            String  @id @default(cuid())
  name          String  @unique
  weightPerUnit Float   @default(0)
  isActive      Boolean @default(true)
}

// SCM delay-reason codes (col E) + their sub-detail definitions (col F). Admin/SCM editable.
// Used as the dropdown source for the SCM claim-assignment (web + Export/Import Excel).
model MasterDelayCode {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "2C_Buy Not Ready"
  definitions String[] @default([]) // e.g. ["2.1 Fabric approval, trim approval", ...]
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt
}

// MasterGMTType + MasterPort removed — unused (Port kept only as a display field on items;
// freight rate is keyed by Country via MasterFreightRate).

// Freight rate keyed by COUNTRY (destination) only. MER selects the country; the rate
// is the same regardless of brand. Est. Air Freight = grossWeight × rate.
model MasterFreightRate {
  id        String   @id @default(cuid())
  country   String
  bu        String   @default("ALL") // "ALL" = shared across BUs (default); a BU-specific row overrides
  currency  String   @default("THB") // legacy — kept for back-compat; rates now use ratePerKg (THB) + rateUsd (USD)
  ratePerKg Float    @default(0) // THB per kg (NYG / GW / TRM)
  rateUsd   Float    @default(0) // USD per kg (EA) — separate field so a country can hold both
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([country, bu])
  @@index([country])
}

model AirRequest {
  id                  String              @id @default(cuid())
  documentNo          String              @unique
  brandName           String
  buName              String
  status              String              @default("DRAFT")
  claimDepartment     String?
  rejectionReason     String?
  isTest              Boolean             @default(false)
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  invoiceNo           String?
  actualAirFreight    Float?
  bookingDate         DateTime?
  airline             String?
  assignedVpMer       String? // 2nd merch approver (VP MER / EA DVM) — chosen by the 1st approver
  assignedDvmMer      String? // 1st merch approver (DVM MER / EA ADVM) — chosen by MER at upload (NYG+EA)
  vpMerToken          String?
  gmToken             String?
  presidentToken      String?
  scmToken            String?
  vpScmToken          String?
  assignedVpScm       String?
  logisticsToken      String?
  accountingToken     String?
  claimGwToken        String?
  claimSupplierToken  String?
  scmNykToken         String?
  scmNykApproverToken String?
  scmNykEvpToken      String?
  scmNygToken         String?
  crNo                String?
  assignedScmNykEvp   String?
  assignedScmNykCr    String?
  claimNextEmail      String?
  claimNextToken      String?
  claimNextName       String?
  bu                  String              @default("NYG")
  logisticsSent       Boolean             @default(false) // LG pressed "Save & Send" (not just Save Draft) → chip turns green
  pendingRate         Boolean             @default(false) // held: Country rate missing, not yet sent to first approver
  pendingWeight       Boolean             @default(false) // held: a DESCRIPTION has no WT Charge in Master, not yet sent
  nykDirect           Boolean             @default(false) // GW "NYK Direct" import: skips all approvers → lands at SCM NYK claim; after NYK done → Accounting (skip President)
  revised             Boolean             @default(false) // was sent back to Merchandise & re-submitted at least once → emails show a "REVISE" tag
  lgForwardEmail      String? // LG handoff: a senior LG forwarded this doc's data-entry to a subordinate. = PRIMARY recipient (arrays[0]) kept for existing single-field display/authz
  lgForwardName       String?
  lgForwardBy         String? // who forwarded (name)
  lgForwardToken      String? // magic-link for the PRIMARY recipient (= lgForwardTokens[0])
  lgForwardEmails     String[] @default([]) // ALL Sub-LG recipients of the handoff (multi-forward)
  lgForwardNames      String[] @default([]) // parallel to lgForwardEmails
  lgForwardTokens     String[] @default([]) // parallel per-recipient magic-link tokens (distinct identity per person)
  vndRate             Float? // EA only: VND-per-THB snapshot at creation → lets amounts display in VND (toggle) without changing later when the FX rate is edited
  createdBy           User                @relation(fields: [createdById], references: [id])
  items               AirRequestItem[]
  approvalLogs        ApprovalLog[]
  attachments         RequestAttachment[]
  hawbGroups          HawbGroup[]
  claimForwards       ClaimForward[]
  approvalSignatures  ApprovalSignature[]
}

// A signature snapshot captured at the moment a person APPROVES (not data entry).
// Snapshotted (not linked to User.signatureData) so later signature changes never
// alter documents already signed. Stamped into the output PDF.
model ApprovalSignature {
  id            String     @id @default(cuid())
  requestId     String
  userId        String?
  approverName  String
  approverEmail String?
  role          String?
  positionLabel String? // e.g. "VP MER", "President", "SCM NYK EVP", "Commercial"
  signatureData String // base64 PNG snapshot at approval time
  crNo          String? // for SCM NYK claim
  branch        String? // BU
  signedAt      DateTime   @default(now())
  request       AirRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// Per-department forward state. Each claim department handles its own SO(s)
// independently: it can finish (finalize its splits) or forward to a chosen
// person (recursively). One active row per (request, dept); the token logs the
// forwarded person in as CLAIM_NEXT_APPROVER scoped to that dept.
// A claim approver's request to add a NEW person for the next position. Held here
// until an Admin approves; only then is the user created, the SO forwarded, and the
// new person alerted. Captures the full forward context so it can run on approval.
model PendingApprover {
  id            String   @id @default(cuid())
  requestId     String
  dept          String
  role          String
  positionLabel String
  fromPos       Int      @default(0)
  nextEmail     String
  nextName      String?
  bu            String   @default("GW")
  branch        String?
  itemIds       Json?
  requestedBy   String?
  requestedName String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt     DateTime @default(now())

  @@index([status])
}

model ClaimForward {
  id        String     @id @default(cuid())
  requestId String
  dept      String
  nextEmail String
  nextName  String?
  token     String     @unique
  position  Int        @default(0)
  branch    String?
  itemIds   Json? // SO ids this forward covers (null = whole dept, legacy). Enables
  // forwarding different SO subsets of one dept to different people.
  createdAt DateTime   @default(now())
  request   AirRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, dept])
}

model ClaimApproval {
  id        String         @id @default(cuid())
  itemId    String
  userId    String
  role      String
  createdAt DateTime       @default(now())
  item      AirRequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
}

model HawbGroup {
  id          String           @id @default(cuid())
  requestId   String
  hawbNo      String
  totalCharge Float
  createdAt   DateTime         @default(now())
  request     AirRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items       AirRequestItem[]
}

model AirRequestItem {
  id                   String          @id @default(cuid())
  requestId            String
  hawbGroupId          String?
  style                String
  so                   String
  brand                String?
  sub                  String?
  customerPO           String?
  description          String?
  gmtType              String?
  originalShipmentDate DateTime?
  planShipmentDate     DateTime?
  qtyOriginalShipment  Int
  qtyRequestAir        Int
  itemStatus           String          @default("PENDING")
  itemComment          String?
  reasonDelay          String
  factory              String
  country              String
  port                 String
  grossWeight          Float?
  airFreight           Float?
  marketRatePerKg      Float?
  actualAirFreight     Float?
  claimDepartment      String?
  claimDepts           Json?
  invoiceNo            String?
  hawbNo               String?
  bookingDate          DateTime?
  assignedDvm          String?
  claimPercentage      Float?
  qtyActualShip        Int?
  shipmentGroupId      String? // split shipments of one SO share this → plan totals count the group once
  request              AirRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  hawbGroup            HawbGroup?      @relation(fields: [hawbGroupId], references: [id], onDelete: SetNull)
  claimApprovals       ClaimApproval[]
}

model ApprovalLog {
  id         String     @id @default(cuid())
  requestId  String
  userId     String
  action     String
  fromStatus String
  toStatus   String
  comment    String?
  createdAt  DateTime   @default(now())
  request    AirRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Global key-value app settings (test email override, maintenance mode, …).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Bill of Material — a REFERENCE table synced by RPA (not part of the approval flow). The app
// reads it to map a MER-uploaded SO → its garment PO(s): match SO + Style + Customer PO.
// If several rows match, several POs are shown ("PO A / PO B / …"). RLS not used (Prisma direct).
model BillOfMaterial {
  id           String   @id @default(uuid())
  bu           String?
  soNoDoc      String?
  customerName String?
  customerPo   String?
  vendorName   String?
  poNoDoc      String?
  style        String?
  updatedAt    DateTime @default(now())

  @@index([soNoDoc, style, customerPo])
}

model RequestAttachment {
  id           String     @id @default(cuid())
  requestId    String
  itemId       String?
  uploadedById String
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  claimDept    String?
  category     String?
  hawbNo       String?    // LG supporting file attached to a specific HAWB
  createdAt    DateTime   @default(now())
  request      AirRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Pull Material ─────────────────────────────────────────────────────────
// Cross-country material pull, seeded (snapshot) from the Bill of Material.
// Separate module from the air-request/claim flow. BU-split (NYG/EA/TRM/GW).
model PullMaterialRequest {
  id             String             @id @default(cuid())
  documentNo     String             @unique
  bu             String
  status         String             @default("PENDING_LOGISTICS")
  requestType    String             @default("SCM") // SCM (SCM-initiated → VP SCM → President) | PURCHASING (PC-initiated → DVM Pur → VP Pur)
  mode           String             @default("IRREGULAR") // REGULAR (fast-track, no wait for approval) | IRREGULAR (full approval). Auto-suggested from SO prefix / port / weight; editable per doc.
  isTest         Boolean            @default(false) // admin TEST doc: every email reroutes to the creator (monitor-only), shows "meant for"
  requesterName  String
  requesterEmail String?
  remark         String?
  packages       Json?              // PC packing list (per shipment): [{ uom, qty }]
  // LG closes ONCE per document (1 shipment / 1 doc): actual air freight + INV + HAWB.
  actualAir      Float?
  invoiceNo      String?
  hawbNo         String?
  attachments    PullMaterialAttachment[]
  recallReason   String?
  recalledBy     String?
  actors         String[]           @default([]) // emails of everyone who acted (PC/LG/SCM) — notified on recall
  createdById    String
  items          PullMaterialItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PullMaterialItem {
  id              String              @id @default(cuid())
  requestId       String
  request         PullMaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Snapshot from BOM (per material line — locked at select time)
  soNoDoc         String
  customerName    String?
  customerPo      String?
  vendorName      String?
  poNoDoc         String?
  style           String?
  brand           String?
  gmtType         String?
  itemCode        String?
  itemName        String?
  orderQty        Float?
  bomQty          Float?
  bomUom          String?
  consumption     Float?
  shipmentDate    DateTime?
  soYear          String?
  groupCode       String?
  ou              String?   // OU (report column) — G-group / factory code (G1..G4, S9 …)
  cpartNo         String?
  partDesc        String?
  itemNo          String?
  poqtyBomdummy   Float?
  poDate          DateTime?
  updInhouse      DateTime?
  bomStatus       String?
  poUsername      String?
  mrdDate         DateTime?
  mrdNeedDate     DateTime?
  mrd2            DateTime?
  // SCM input
  pullGarment     Float?
  pullMaterialQty Float?
  airDecision     String?
  inHouseAirDate  DateTime?
  inHouseSeaDate  DateTime?
  sewingStartDate DateTime?
  reasonAirPick   String?
  grossWeightKg   Float?
  airFreightCost  Float?
  // Logistics input
  estAir          Float?
  estSea          Float?
  leadTimeAir     String?
  leadTimeSea     String?
  seaFreightCost  Float?
  incotermCost    Float?    // freight-side incoterm cost entered by LG (per the term PC picked)
  // Purchasing input
  weight          Float?    // confirmed / revised per-unit weight (kg)
  weightGenerated Float?    // system-suggested weight (ref)
  country         String?   // origin country — picked by PC (drives which ports show)
  city            String?   // origin city — picked by PC from Master Purchase (carries country/port)
  port            String?   // origin AIR PORT CODE — picked by PC (for air rate)
  seaPort         String?   // origin SEA PORT — picked by PC (for sea rate)
  incoterm        String?   // FOB / CIF / EX-WORK / FCA — picked by PC
  pickupAddress   String?   // pickup / supplier address — required only when incoterm = EX-WORK or FCA
  needDate        DateTime? // when Purchasing needs the goods (moved from LG's in-house; LG now auto-calcs)
  cartons         Float?    // number of cartons (PC)
  boxW            Float?    // carton dimension width  (cm, optional)
  boxL            Float?    // carton dimension length (cm, optional)
  boxH            Float?    // carton dimension height (cm, optional)
  // LG actual (close)
  invoiceNo       String?
  actualAir       Float?
  createdAt       DateTime            @default(now())

  @@index([requestId])
  @@index([soNoDoc])
}

// Pull RM AIR freight master (from Rate_LG.xlsx "AIR RATE", cols A-O). Separate from Air Request's
// country-based MasterFreightRate — Pull RM matches by PORT (origin → BKK). Rates by weight break
// stored as JSON { Q45, Q100, Q250, Q300, Q500, Q1000, Q2000, Q8000, M, N } (sparse, USD/kg).
model PullFreightAir {
  id          String   @id @default(cuid())
  origin      String   // AIR PORT CODE (e.g. HKG, SHA)
  country     String?  // origin country (maps port → country so PC can pick by country)
  destination String   @default("BKK")
  fwd         String?  // forwarder
  airline     String?  // A/L
  tt          String?  // transit time
  origCostExw Float?   // origin cost when incoterm = EX-WORK (Orig Cost (EXW) col in Rate_LG)
  origCostFca Float?   // origin cost when incoterm = FCA (Orig Cost (FCA) col in Rate_LG)
  rates       Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([origin])
}

// Pull RM SEA freight master (from Rate_LG.xlsx "SEA RATE"). Keyed by origin sea port (grouped by
// country). rates = { "40GP": USD/CTR, "20GP": USD/CTR, "LCL": USD/CBM } (sparse).
model PullFreightSea {
  id        String   @id @default(cuid())
  country   String
  port      String   // sea port (e.g. KEELUNG, HO CHI MINH)
  leadTime  String?  // sea lead time (L/T) — read from the Rate_LG "SEA RATE" sheet
  rates     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([port])
}

// Pull RM "Master Purchase" — Country / Port / City. Purchasing picks a City on the request; its
// Country + Port carry onto the pulled items. Maintained by Admin + Purchasing.
model PullPurchaseCity {
  id        String   @id @default(cuid())
  country   String
  port      String
  city      String
  createdAt DateTime @default(now())

  @@index([city])
}

// File attached to a Pull Material request (stored in the shared Supabase bucket, mirrors RequestAttachment).
model PullMaterialAttachment {
  id           String              @id @default(cuid())
  requestId    String
  uploadedById String?
  fileName     String
  filePath     String              // Supabase storage path
  fileSize     Int
  mimeType     String
  createdAt    DateTime            @default(now())
  request      PullMaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// Sample log — free-text entries (Brand / Supplier / Qty / Remark). All Pull RM roles.
model PullSample {
  id        String   @id @default(cuid())
  brand     String?
  supplier  String?
  qty       String?
  remark    String?
  createdBy String?  // username of whoever added it
  createdAt DateTime @default(now())

  @@index([createdAt])
}
